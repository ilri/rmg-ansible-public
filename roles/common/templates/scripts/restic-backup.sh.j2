#!/usr/bin/env bash
{{ ansible_managed | comment }}

{{ restic_binary_path }} version

# Check if the repository is already initialized by checking its config
# See: https://restic.readthedocs.io/en/latest/075_scripting.html
{{ restic_binary_path }} cat config

if [[ $? -eq 1 ]]; then
    {{ restic_binary_path }} init
fi

# exit on first error
set -e

echo 'Removing stale locks'
{{ restic_binary_path }} unlock

echo 'Starting restic check'
{{ restic_binary_path }} check

echo 'Starting restic backup of {{ restic_backup_paths|join(" ") }}'
{{ restic_binary_path }} backup {{ restic_backup_paths|join(" ") }}
